meta {
  name: get data from cache
  type: http
  seq: 3
}

post {
  url: {{url}}/v1/data
  body: json
  auth: inherit
}

body:json {
  {
    "query_id": "users:4",
    "skip_cache": false
  }
}

tests {
  test("200 OK", function () {
    expect(200).to.equal(res.status);
  })
  
  test("From Cache", function () {
    expect(true).to.equal(res.body.fromCache);
  })
  
  const decoded = Buffer.from(res.body.data, 'base64').toString('utf-8');
  console.log("get data from cache: " + decoded);
  const parsed = JSON.parse(decoded);
  
  test("Expected ID", function () {
    expect(4).to.equal(parsed.id);
  })
  
  test("Expected Name", function () {
    expect('Nishiwaki').to.equal(parsed.name);
  })
  
  test("Expected Email", function () {
    expect('aoaoan@neo.net').to.equal(parsed.email);
  })
  
  test("Expected Age", function () {
    expect(49).to.equal(parsed.age);
  })
}

settings {
  encodeUrl: true
}
