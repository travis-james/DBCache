meta {
  name: cache miss
  type: http
  seq: 4
}

post {
  url: {{url}}/v1/data
  body: json
  auth: inherit
}

body:json {
  {
    "query_id": "users:2",
    "fallback_query": {
      "query": {{query}},
      "args": [
        "2"
      ]
    },
    "skip_cache": false
  }
}

tests {
  test("200 OK", function () {
    expect(200).to.equal(res.status);
  })
  
  test("NOT from Cache", function () {
    expect(false).to.equal(res.body.fromCache);
  })
  
  const decoded = Buffer.from(res.body.data, 'base64').toString('utf-8');
  console.log("cache miss: " + decoded);
  const parsed = JSON.parse(decoded);
  
  test("Expected ID", function () {
    expect(2).to.equal(parsed.id);
  })
  
  test("Expected Name", function () {
    expect('Oomoto').to.equal(parsed.name);
  })
  
  test("Expected Email", function () {
    expect('nocchi@perfume.com').to.equal(parsed.email);
  })
  
  test("Expected Age", function () {
    expect(36).to.equal(parsed.age);
  })
}

settings {
  encodeUrl: true
}
