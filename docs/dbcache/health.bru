meta {
  name: health
  type: http
  seq: 2
}

get {
  url: {{url}}/v1/health
  body: none
  auth: inherit
}

tests {
  test("200 OK", function () {
    expect(200).to.equal(res.status);
  })
  
  const body = res.body;
  
  test("Response is Healthy", function () {
    expect(true).to.equal(body.healthy);
    expect('').to.equal(body.cacheError);
    expect('').to.equal(body.dbError);
  })
  
  test("No Cache Error", function () {
    expect(body.cacheError).to.equal('');
  })
  
  test("No DB Error", function () {
    expect(body.dbError).to.equal('');
  })
  
}

settings {
  encodeUrl: true
}
