meta {
  name: invalidate cache entries
  type: http
  seq: 6
}

post {
  url: {{url}}/v1/invalidate
  body: json
  auth: inherit
}

body:json {
  {
    "keys": [
      "users:9999",
      "users:1"
    ]
  }
}

tests {
  expect(res.status).to.equal(200);
  
  expect(res.body.entriesRemoved).to.equal("2");
  
}

settings {
  encodeUrl: true
}
