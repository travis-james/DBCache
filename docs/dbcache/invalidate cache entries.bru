meta {
  name: invalidate cache entries
  type: http
  seq: 6
}

post {
  url: {{url}}/v1/invalidate
  body: json
  auth: inherit
}

body:json {
  {
    "keys": [
      "users:9999",
      "users:1"
    ]
  }
}

tests {
  test("200 OK", function () {
    expect(200).to.equal(res.status);
  })
  
  test("Correct Number of Entries Removed", function () {
    expect("2").to.equal(res.body.entriesRemoved);
  })
}

settings {
  encodeUrl: true
}
